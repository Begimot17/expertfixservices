<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # The contact form. Hostinger Premium has no Node, so apps/api is not
  # deployed and the endpoint is PHP — but the client posts to /api/contact and
  # should not have to know that. Without this line the request falls through to
  # index.html below and the form silently "succeeds" while sending nothing.
  RewriteRule ^api/contact/?$ api/contact.php [L]

  # Anything that exists on disk is served as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else is the app, and index.html decides what it is.
  RewriteRule ^ /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Hashed assets are immutable; index.html must never be cached, or a deploy
  # takes a week to reach anyone who has already visited.
  <FilesMatch ".(js|css|woff2?|jpg|jpeg|png|svg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch ".html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

ErrorDocument 404 /index.html
